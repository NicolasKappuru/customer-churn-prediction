\@writefile{toc}{\contentsline {subsection}{\numberline {7.1}Baseline: Full Dataset (All Subscription States)}{17}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Full-dataset results on March (970{,}960 users, 8.99\% churn) at tuned thresholds. Random Forest (M2) is the winner. The high threshold for M3 reflects un-calibrated XGBoost probabilities caused by class-weight inflation.}}{17}{}\protected@file@percent }
\newlabel{tab:w1_results_full}{{12}{17}{}{table.12}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.2}Manual Segment Results}{17}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces Manual-segment results on March (113{,}048 users, 40.74\% churn) at threshold 0.5. M3 (XGBoost with early stopping) achieves the best log-loss and average precision; M2 (Random Forest) has the best F1 and MCC.}}{17}{}\protected@file@percent }
\newlabel{tab:w1_results_manual}{{13}{17}{}{table.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Confusion matrices of M1--M3 on the March manual cohort at threshold 0.5.}}{18}{}\protected@file@percent }
\newlabel{fig:w1_conf_manual}{{4}{18}{}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces ROC and precision--recall curves of M1--M3 on the March manual cohort.}}{18}{}\protected@file@percent }
\newlabel{fig:w1_roc_pr_manual}{{5}{18}{}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Reliability diagrams of M1--M3 on the March manual cohort. Near-balanced prevalence (40.74\%) means scores close to 0.5 correspond to true probabilities without recalibration.}}{18}{}\protected@file@percent }
\newlabel{fig:w1_calib_manual}{{6}{18}{}{figure.6}{}}
